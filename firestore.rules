rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 全国ランキング： boards/{mode_diff}/scores/{auto}
    match /boards/{board}/scores/{doc} {
      allow read: if true;                       // 誰でも閲覧可
      allow create: if isValidScore();           // 投稿は検証つきで許可
      allow update, delete: if false;            // 改ざん・削除は不可
    }
    function isValidScore() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name','score','mode','diff','stage','ts'])
        && d.score is int && d.score >= 0 && d.score <= 100000000
        && d.stage is int && d.stage >= 0 && d.stage <= 300
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 12
        && d.mode is string && d.mode.size() <= 12
        && d.diff is string && d.diff.size() <= 8
        && d.ts is int;
    }
  }
}
