{
  "hosting": [
    {
      "site": "shorui-invader",
      "public": ".",
      "ignore": [
        "firebase.json",
        ".firebaserc",
        "**/.*",
        ".git/**",
        ".firebase/**",
        "**/node_modules/**",
        "juen/**",
        "dev/**"
      ],
      "headers": [
        {
          "source": "**/*.html",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "**/*.@(js|css)",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "**/*.@(png|svg|ico|mp3)",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
        }
      ]
    }
  ]
}
